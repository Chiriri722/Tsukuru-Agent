{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsukuru-agent.dev/schemas/v2/result.schema.json",
  "title": "Tsukuru Agent result contract v2",
  "type": "object",
  "required": ["schemaVersion", "ok", "format", "artifacts", "stats", "warnings", "warningDetails", "error"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 2 },
    "ok": { "type": "boolean" },
    "format": { "type": ["string", "null"] },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "stats": { "type": "object", "additionalProperties": true },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "warningDetails": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
    "translationQuality": { "$ref": "#/$defs/translationQuality" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "error": { "anyOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }] }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "launchProbe": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/launchProbe" }] }
      }
    },
    "launchProbe": {
      "type": "object",
      "required": ["status", "executable", "timeoutMs", "elapsedMs", "exitCode", "signal", "timedOut", "terminatedByProbe", "stdout", "stderr"],
      "additionalProperties": true,
      "properties": {
        "status": { "enum": ["running", "exited-ok", "exited-error", "failed"] },
        "executable": { "type": "string" },
        "timeoutMs": { "type": "integer", "minimum": 0 },
        "elapsedMs": { "type": "integer", "minimum": 0 },
        "exitCode": { "type": ["integer", "null"] },
        "signal": { "type": ["string", "null"] },
        "timedOut": { "type": "boolean" },
        "terminatedByProbe": { "type": "boolean" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "error": { "type": "string" },
        "isolation": {
          "type": "object", "additionalProperties": false,
          "required": ["strategy", "verified", "processTreeTerminated", "cleanup"],
          "properties": {
            "strategy": { "const": "electron-bootstrap-v1" },
            "verified": { "type": "boolean" },
            "processTreeTerminated": { "type": "boolean" },
            "cleanup": { "enum": ["removed", "retained"] }
          }
        }
      },
      "allOf": [{
        "if": { "required": ["isolation", "status"], "properties": { "status": { "enum": ["running", "exited-ok"] } } },
        "then": { "properties": { "isolation": { "properties": {
          "verified": { "const": true }, "processTreeTerminated": { "const": true }, "cleanup": { "const": "removed" }
        } } } }
      }]
    },
    "translationQuality": {
      "type": "object",
      "required": ["mechanical", "language", "context", "semantics", "entriesChecked", "sourcePreserved", "issueCount", "omittedCount", "issues"],
      "additionalProperties": false,
      "properties": {
        "mechanical": { "enum": ["pass", "fail", "not-run"] },
        "language": { "enum": ["pass", "needs-review", "not-run"] },
        "context": { "enum": ["pass", "needs-review", "not-run"] },
        "semantics": { "const": "not-run" },
        "entriesChecked": { "type": "integer", "minimum": 0 },
        "sourcePreserved": { "type": "integer", "minimum": 0 },
        "issueCount": { "type": "integer", "minimum": 0 },
        "omittedCount": { "type": "integer", "minimum": 0 },
        "issues": {
          "type": "array", "maxItems": 100,
          "items": {
            "type": "object", "required": ["code", "severity", "file"], "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "pattern": "^RPG_[A-Z0-9_]+$" },
              "severity": { "enum": ["error", "warning", "info"] },
              "file": { "type": "string", "maxLength": 320 },
              "entryId": { "type": "string", "maxLength": 320 },
              "reason": { "type": "string", "maxLength": 320 }
            }
          }
        }
      }
    },
    "warning": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^W_[A-Z0-9_]+$" },
        "message": { "type": "string" },
        "details": true
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": true,
      "properties": {
        "code": { "type": "string", "pattern": "^E_[A-Z0-9_]+$" },
        "message": { "type": "string" }
      }
    }
  }
}
